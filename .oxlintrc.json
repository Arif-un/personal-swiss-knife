{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "eqeqeq": "warn",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist",
    "src-tauri",
    "node_modules",
    "src/components/ui"
  ]
}
